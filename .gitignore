# --- private personal data: never committed ---
/data/
/backups/
*.db
*.db-wal
*.db-shm
*.jsonl
# exports carry the same content as the database: README's export commands
# write archive/ and archive-data/, and phone/health exports arrive as zips.
# /demo/ is a generated demo root (rebuildable, never source).
/archive/
/archive-data/
/exports/
/demo/
*.zip

# --- personal exports saved into the project folder: the guides run every
# import from the project root, often with a relative path (`observe finance
# statements/`, `observe location Timeline.json`, `review --check brief.md
# --out brief-sourced.txt`), and only some sources arrive as zips. Anchored
# to the root on purpose: the synthetic exports under tests/fixtures/ and the
# demo generators in lifecrm/demo/ are source, and stay visible. The letter
# classes are for case-sensitive checkouts: banks name files .CSV and .OFX.
/*.[vV][cC][fF]
/*.[iI][cC][sS]
/*.[cC][sS][vV]
/*.[oO][fF][xX]
/*.[qQ][fF][xX]
/*.[qQ][bB][oO]
/*.[xX][mM][lL]
/*.[jJ][sS][oO][nN]
/WhatsApp Chat*
/[tT]akeout*/
/apple_health_export/
/statements/
/vault/
/brief*
/kept*.txt

# --- environment ---
/.venv/
__pycache__/
*.pyc
.pytest_cache/

# --- local-only config (config.example.toml IS committed) ---
/config.toml

# --- per-machine Claude Code permissions; the exclusion must travel with the
# repo, not depend on any one machine's global gitignore ---
.claude/settings.local.json

# --- demo instances (lifecrm demo): synthetic, rebuildable, never committed ---
/demo/

# --- Claude Code worktrees for parallel agents ---
/.claude/worktrees/
