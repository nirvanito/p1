# --- private personal data: never committed ---
/data/
/backups/
*.db
*.db-wal
*.db-shm
*.jsonl
# exports carry the same content as the database: README's export commands
# write archive/ and archive-data/, and phone/health exports arrive as zips.
# /demo/ is a generated demo root (rebuildable, never source).
/archive/
/archive-data/
/exports/
/demo/
*.zip

# --- environment ---
/.venv/
__pycache__/
*.pyc
.pytest_cache/

# --- local-only config (config.example.toml IS committed) ---
/config.toml

# --- per-machine Claude Code permissions; the exclusion must travel with the
# repo, not depend on any one machine's global gitignore ---
.claude/settings.local.json

# --- demo instances (lifecrm demo): synthetic, rebuildable, never committed ---
/demo/

# --- Claude Code worktrees for parallel agents ---
/.claude/worktrees/
